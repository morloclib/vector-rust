module vector-rust (*)

import vector
import root-rust

-- Vector shares its Rust runtime form (@Vec@) with List, so the same
-- operations apply. vector.rs provides @morloc_vec_*@ implementations with
-- distinct names (root-rust's core.rs @morloc_*@ family is included in the same
-- pool, so shared names would collide).

source Rust from "vector.rs"
    ( "morloc_zeros1" as zeros1
    , "morloc_ones1"  as ones1
    , "morloc_fill1"  as fill1
    )

instance SemigroupDim Vector where
  source Rust from "vector.rs" ("morloc_vec_concat" as (++))

instance MonoidDim Vector where
  empty0 = []

instance Indexable (Vector n) where
  source Rust from "vector.rs" ("morloc_vec_at" as __access_index__)

instance SliceableDim Vector where
  source Rust from "vector.rs" ("morloc_vec_slice" as __get_slice_dim__)

instance Functor (Vector n) where
  source Rust from "vector.rs" ("morloc_vec_map" as map)

instance Foldable (Vector n) where
  source Rust from "vector.rs"
    ( "morloc_vec_fold" as fold
    , "morloc_vec_fold1" as fold1
    , "morloc_vec_safeFold1" as safeFold1
    , "morloc_vec_length" as length
    )

instance Sizeable (Vector n a) where
  source Rust from "vector.rs" ("morloc_vec_size" as size)

instance Eq (Vector n a) where
  source Rust from "vector.rs" ("morloc_vec_eq" as (==), "morloc_vec_ne" as (!=))

instance Ord (Vector n a) where
  source Rust from "vector.rs"
    ( "morloc_vec_lt" as (<)
    , "morloc_vec_le" as (<=)
    , "morloc_vec_gt" as (>)
    , "morloc_vec_ge" as (>=)
    )
